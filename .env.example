# Environment Variables for DevCraft
# Copy this file to .env and fill in the values

# Groq API Key (required) — Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq model (optional, default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Database URL (required)
# For NeonDB: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/devcraft

# LLM Settings
MAX_IDEAS=5
